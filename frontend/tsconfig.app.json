{
  // Код интерфейса: только браузерные типы. Конфиги Vite, Vitest и Playwright проверяет tsconfig.node.json.
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Режим бандлера: собирает Vite, tsc только проверяет типы. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* Строгость */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "bindings"],
  // Тест правил ESLint выполняется в Node — его проверяет tsconfig.node.json.
  "exclude": ["src/test/i18n-lint.test.ts"]
}

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{go.mod,go.sum}]
indent_style = tab

[*.{ts,tsx,js,jsx,mjs,cjs,json,yml,yaml,md,html,css}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{nsi,nsh}]
indent_style = space
indent_size = 4
